<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>TravelPlugin</AssemblyName>
    <RootNamespace>TravelPlugin</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Travel</Product>
    <Description>Multibox travel hotkeys for Anarchy Online (AO# plugin)</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AOSharp.Core"><HintPath>..\lib\AOSharp.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AOSharp.Common"><HintPath>..\lib\AOSharp.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>..\lib\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Serilog"><HintPath>..\lib\Serilog.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="UI\TravelWindow.xml"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
  </ItemGroup>
</Project>
